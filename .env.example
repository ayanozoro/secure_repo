# ==========================================
# SecureDevOps Environment Configuration
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/securedevops?schema=public"

# Redis (for background jobs, caching, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GitHub App / OAuth Configuration
# (Can be configured with a GitHub Personal Access Token or GitHub App)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# OSV API Configuration
OSV_API_BASE_URL="https://api.osv.dev/v1"
OSV_REQUEST_TIMEOUT_MS=10000
OSV_MAX_CONCURRENCY=5
OSV_CACHE_TTL_MS=3600000

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
